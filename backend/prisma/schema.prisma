generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum UserRole {
  ADOPTER
  NGO
  ADMIN
}


enum AdoptionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}


enum AnimalStatus {
  AVAILABLE
  PENDING
  ADOPTED
}

enum AnimalSpecies {
  DOG
  CAT
  BIRD
  RABBIT
  OTHER
}

enum AnimalSize {
  SMALL   
  MEDIUM  
  LARGE   
}

enum AnimalGender {
  MALE
  FEMALE
}


model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String   
  role      UserRole @default(ADOPTER)

  phone     String?
  bio       String?
  city      String?
  state     String?
  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  
  animals   Animal[]

  
  adoptions Adoption[]

 
  favorites Favorite[]

  
  sentMessages Message[]

  @@index([email])
  @@index([role])
  @@map("users")
}


model Animal {
  id          String        @id @default(cuid())
  name        String
  species     AnimalSpecies
  breed       String?       
  age         Int?          
  gender      AnimalGender
  size        AnimalSize
  description String?       
  status      AnimalStatus  @default(AVAILABLE)
  isVaccinated Boolean      @default(false)
  isNeutered   Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  
  ngoId String
  ngo   User   @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  
  images    Image[]
  adoptions Adoption[]
  favorites Favorite[]

  @@index([status])
  @@index([species])
  @@index([ngoId])
  @@map("animals")
}


model Adoption {
  id      String         @id @default(cuid())
  status  AdoptionStatus @default(PENDING)
  message String?        

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime? 

  
  adopterId String
  adopter   User   @relation(fields: [adopterId], references: [id], onDelete: Cascade)

  
  animalId String
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

 
  messages  Message[]

  @@index([adopterId])
  @@index([animalId])
  @@index([status])
  @@map("adoptions")
}


model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  animalId String
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@unique([userId, animalId])
  @@index([userId])
  @@map("favorites")
}


model Image {
  id        String   @id @default(cuid())
  url       String   
  key       String   @unique 
  isPrimary Boolean  @default(false)

  createdAt DateTime @default(now())

  animalId String?
  animal   Animal? @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@map("images")
}


model Message {
  id        String   @id @default(cuid())
  content   String

  createdAt DateTime @default(now())

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  adoptionId String
  adoption   Adoption @relation(fields: [adoptionId], references: [id], onDelete: Cascade)

  @@index([adoptionId])
  @@index([senderId])
  @@map("messages")
}
