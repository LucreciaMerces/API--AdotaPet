# ──────────────────────────────────────────
#  AdotaPet — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha
# ──────────────────────────────────────────

# Ambiente da aplicação
NODE_ENV=development

# Servidor
PORT=3333
API_PREFIX=/api/v1

# Banco de dados PostgreSQL
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/adotapet?schema=public"

# JWT (será usado no Sprint 3)
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio_aqui
JWT_EXPIRES_IN=7d

# Upload de arquivos (será usado no Sprint 6)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# CORS — origens permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
